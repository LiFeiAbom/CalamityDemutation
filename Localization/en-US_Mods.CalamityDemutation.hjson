			{$CommonItemTooltip.SummonTagDamage}
			12% summon tag critical strike chance
			{$CommonItemTooltip.Whips}
			Summons a phantom Eilodon Wyrm that attacks enemies and inflicts Life Oppression on hit
			'''
	}

	CadencePotion: {
		DisplayName: Cadence Potion
		Tooltip:
			'''
			Gives the cadence buff which reduces shop prices and enemy aggro
			Increases life regen and increases max life by 20%
			Increases heart pickup range
			'''
	}

	RevivifyPotion: {
		DisplayName: Revivify Potion
		Tooltip: Causes enemy attacks to heal you for a fraction of their damage
	}

	TitanScalePotion: {
		DisplayName: Titan Scale Potion
		Tooltip: Increases knockback, defense by 5, and damage reduction by 5%
	}

	HolyWrathPotion: {
		DisplayName: Holy Wrath Potion
		Tooltip:
			'''
			Increases damage by 12% and increases movement and horizontal flight speed by 5%
			Attacks inflict holy fire
			'''
	}

	TriumphPotion: {
		DisplayName: Triumph Potion
		Tooltip: Enemy contact damage is reduced, the lower their health the more it is reduced
	}

	BoundingPotion: {
		DisplayName: Bounding Potion
		Tooltip: Increases jump height, jump speed, and fall damage resistance
	}

	CrumblingPotion: {
		DisplayName: Crumbling Potion
		Tooltip:
			'''
			Increases critical strike chance by 5%
			Attacks break enemy armor
			'''
	}

	PhotosynthesisPotion: {
		DisplayName: Photosynthesis Potion
		Tooltip:
			'''
			You regen life quickly while not moving, this effect is five times as strong during daytime
			Dropped hearts heal more HP
			'''
	}

	ProfanedRagePotion: {
		DisplayName: Profaned Rage Potion
		Tooltip: Increases critical strike chance by 12% and increases movement and horizontal flight speed by 5%
	}

	ShatteringPotion: {
		DisplayName: Shattering Potion
		Tooltip:
			'''
			Increases damage and critical strike chance by 8%
			Attacks break enemy armor
			'''
	}

	SoaringPotion: {
		DisplayName: Soaring Potion
		Tooltip: Increases flight time and horizontal flight speed by 10%
	}

	CalciumPotion: {
		DisplayName: Calcium Potion
		Tooltip: Grants immunity to fall damage
	}

	CeaselessHungerPotion: {
		DisplayName: Ceaseless Hunger Potion
		Tooltip: Causes you to suck up all items in the world
	}

	DraconicElixir: {
		DisplayName: Draconic Elixir
		Tooltip:
			'''
			Greatly increases wing flight time and speed and increases defense by 16
			God slayer revival heals you to full HP instead of 300 HP when triggered
			Silva invincibility heals you to full HP when triggered
			If you trigger the above heals you cannot drink this potion again for 30 seconds
			'''
	}

	AbyssalElixir: {
		DisplayName: Abyssal Elixir
		Tooltip: Grants the Abyssal Wish buff, letting you breathe underwater, even in the Abyss
	}

	ProfanedSoulArtifact: {
		DisplayName: Profaned Soul Artifact
		Tooltip:
			'''
			Purity
			Summons three profaned guardians which accompany you in battle
			The healer guardian heals you for a small amount of health every few seconds
			The defensive guardian increases your movement speed and damage resistance
			The offensive guardian increases your summon damage and grants an extra minion slot
			Your summons inflict Holy Flames on struck enemies
			Provides a small durability shield which recharges after it breaks
			'''
	}

	ProfanedSoulCrystal: {
		DisplayName: Profaned Soul Crystal
		Tooltip:
			'''
			Devotion
			Summons three profaned guardians which accompany you in battle
			Your guardians are empowered, dealing far more damage and attacking far more often
			Provides a large durability shield which recharges after it breaks
			Grants a comprehensive boost to your base stats
			Increases your summon damage by 15% and wing flight time by 10%
			During the day, your summons gain knockback and you move and attack faster
			At night, you gain damage reduction, defense and life regeneration
			Grants immunity to lava and fire
			Weapons additionally fire profaned crystal projectiles, empowered if no minions are active
			[c/ffa680:Melee] [c/ffd2bf:attacks additionally hurl a barrage of spears]
			[c/99ffa7:Ranged] [c/bfffc8:attacks additionally hurl fireballs and meteors]
			[c/8cbeff:Magic] [c/bfdbff:attacks additionally hurl a giant splitting fireball, costing 100 mana]
			[c/d791f2:Whips] [c/e1b6f2:attacks additionally lash with profaned crystal]
			'''
	}
}

