Configs: {
	ConfigSystem: {
		DisplayName: Calamity Demutation Config

		PerformanceMode: {
			Label: Performance Mode
			Tooltip:
				'''
				Reduces rendering load by disabling the afterimage trail effect on this mod's projectiles.
				When enabled, projectiles such as Eon Beams, Biome Orbs, Omega Biome Orbs, Galaxia orbs and Terra Balls are drawn without their layered trail afterimages, rendering only the base sprite.
				This can noticeably improve the framerate during intense fights where many projectiles are on screen at once (e.g. boss battles, invasion events, or farming with heavy melee weapons).
				Visual trade-off: projectiles lose their glowing motion trail, so their flight paths look less flashy and can be slightly harder to track.
				Recommended: enable if you experience frame drops, use low-end hardware, or find the trails distracting.
				Keep it off if you want the full visual effect and have no performance issues.
				Default: Off.
				'''
		}

		RevertVanillaNerfs: {
			Label: Revert Vanilla Nerfs
			Tooltip:
				'''
				Reverts Calamity's nerfs to vanilla player content.
				Restores the original stats of vanilla weapons, armor, tools, wings, accessories, and buffs that Calamity weakens.
				Also reverts the summoner cross-class damage penalty and the Shadow Armor / Soaring Insignia movement nerfs.
				Only applies while the Calamity Mod is enabled.
				Default: Off.
				'''
		}

		RevertCalamityContentNerfs: {
			Label: Revert Calamity Content Nerfs
			Tooltip:
				'''
				Reverts Calamity's nerfs to its own content.
				Only applies while the modern Calamity Mod is enabled.
				Default: Off.
				'''
		}

		EnableSwordLight: {
			Label: Enable Sword Light
			Tooltip:
				'''
				Toggles the sweeping slash trail (arc light) rendered behind this mod's sword-like held projectiles.
				When on, melee swings such as the Dragon Rage draw a glowing motion trail that sweeps across the arc of the strike.
				This effect relies on the KnifeRendering shader, so it also acts as a fallback toggle if that effect ever fails to load.
				Turn it off if you dislike the effect, experience rendering glitches, or want to save some draw overhead.
				Default: On.
				'''
		}

		WeaponAdaptiveIllumination: {
			Label: Weapon Adaptive Illumination
			Tooltip:
				'''
				Controls whether the weapon sprite of this mod's sword-like held projectiles is tinted by the surrounding light level.
				When on, the blade dims slightly in dark areas and brightens in lit ones, matching how the environment shades it.
				When off, the weapon is always drawn at full brightness in plain white, ignoring light — useful if the blade looks too dark in caves or at night.
				Default: On.
				'''
		}
	}
}

