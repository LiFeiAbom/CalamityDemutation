	Terratomere: {
		DisplayName: 泰拉巨刃
		Tooltip:
			'''
			挥舞释放生命洪流
			“与泰拉瑞亚世界之精华相连”
			'''
	}

	TheAbsorber: {
		DisplayName: 阴阳吸星石
		Tooltip:
			'''
			移动速度提高 12%
			跳跃速度提高 120%
			最大生命 +30，最大法力 +20
			静止不动时提升生命与法力再生
			浸没在液体中时防御与伤害减免提升
			浸没在液体中时移动速度提升
			敌怪接触你时会受到伤害
			受到攻击后短时间内移动速度大幅提升
			受击时释放蘑菇孢子与火花爆炸
			伤害减免提高 6%
			敌怪的攻击会有一部分伤害被吸收，并用于治疗你
			'''
	}

	TheAmalgam: {
		DisplayName: 聚合之脑
		Tooltip:
			'''
			所有伤害提高 20%，暴击率提高 10%
			受击时天降暗影
			受击时使附近敌怪陷入混乱
			偶尔从天而降硫磺火球
			无敌期间天降暗影或硫磺火
			暂时免疫岩浆，大幅降低岩浆灼烧伤害，身处岩浆中时伤害提高 25%
			召唤一个真菌团块为你作战
			移动时会在身后留下有毒海水
			浸没时移动速度提高 75%，所有伤害提高 10%，防御 +40
			浸没在液体中时受到伤害，会短时间获得具有伤害的光环
			有几率制造幻象并闪避攻击
			'''
	}

	TheBurningSky: {
		DisplayName: 焚灭天惩
		Tooltip: 挥舞时从天空降下十枚火流星
	}

	TheCommunity: {
