Configs: {
	ConfigSystem: {
		DisplayName: 灾厄复生配置

		PerformanceMode: {
			Label: 性能模式
			Tooltip:
				'''
				关闭本模组弹幕的残影拖尾，以降低渲染负担。
				开启后，远古光束、环境能量、欧米茄环境能量、银河之星与泰拉球等弹幕不再绘制多层残影拖尾，只显示本体贴图。
				在弹幕密集的激烈战斗中（例如 Boss 战、入侵事件，或手持重型近战武器刷怪时），这可明显提升帧率。
				代价是弹幕会失去发光拖尾，飞行轨迹不再炫目，也更难追踪。
				建议在掉帧、使用低配电脑，或觉得拖尾干扰视线时开启。
				若追求完整视觉效果且无性能问题，请保持关闭。
				默认：关闭。
				'''
		}

		RevertVanillaNerfs: {
			Label: 还原原版削弱
			Tooltip:
				'''
				还原灾厄对原版玩家内容的削弱。
				将被灾厄削弱的原版武器、护甲、工具、翅膀、饰品与增益恢复为原始数值。
				同时还原召唤师的跨职业伤害惩罚，以及暗影盔甲与翱翔徽章的移动削弱。
				仅在启用灾厄模组时生效。
				默认：关闭。
				'''
		}

		RevertCalamityContentNerfs: {
			Label: 还原灾厄内容削弱
			Tooltip:
				'''
				还原灾厄对自身内容的削弱。
				仅在启用现代版灾厄模组时生效。
				默认：关闭。
				'''
		}

		EnableSwordLight: {
			Label: 启用剑光
			Tooltip:
				'''
				控制是否在本模组剑类手持弹幕上绘制挥砍弧光。
				开启后，巨龙之怒等近战挥砍会沿挥砍弧线拖出发光残影。
				该效果依赖 KnifeRendering 着色器，因此着色器加载失败时也可用它兜底关闭。
				若不喜欢该效果、遇到渲染异常，或想节省绘制开销，可将其关闭。
				默认：开启。
				'''
		}

		WeaponAdaptiveIllumination: {
			Label: 武器自适应照明
			Tooltip:
				'''
				控制本模组剑类手持弹幕的武器贴图是否受环境光照影响。
				开启后，刀刃在暗处略暗、亮处更亮，与环境明暗保持一致。
				关闭后，武器始终以纯白满亮度绘制，不受光照影响——若在洞穴或夜晚觉得刀刃太暗，可关闭此项。
				默认：开启。
				'''
		}
	}
}

